{
  "name": "chemistry-school",
  "private": true,
  "description": "Статический сайт: химия ОГЭ, темы, тесты",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:oge": "node scripts/build-oge-from-json.mjs",
    "build:oge:legacy": "node scripts/build-oge-from-registry.mjs",
    "validate:oge-phase0": "node scripts/validate-oge-phase0.mjs",
    "validate:oge-phase0:check": "node scripts/validate-oge-phase0.mjs --no-report",
    "migrate:oge-tasks": "node scripts/migrate-oge-html-to-json.mjs",
    "validate:oge-tasks": "node scripts/validate-oge-tasks.mjs",
    "check:oge-duplicates": "node scripts/find-oge-duplicates.mjs",
    "stats:oge-sources": "node scripts/oge-source-stats.mjs",
    "generate:oge-variants": "node scripts/generate-oge-variants.mjs",
    "add:oge-task": "node scripts/add-oge-task.mjs",
    "check:oge-solutions": "node scripts/check-oge-solutions.mjs",
    "build:periodic-table": "node scripts/build-periodic-table.mjs",
    "build:solubility-table": "node scripts/build-solubility-table.mjs",
    "check:site-links": "node scripts/check-site-links.mjs",
    "check:js-syntax": "node scripts/check-js-syntax.mjs",
    "test:unit": "node scripts/test-oge-variant-number.mjs",
    "test:ui": "playwright test",
    "check:generated": "node scripts/check-generated.mjs",
    "verify": "npm run validate:oge-tasks && npm run validate:oge-phase0:check && npm run check:oge-solutions && npm run check:oge-duplicates -- --strict && npm run check:generated && npm run check:site-links && npm run check:js-syntax && npm run test:unit && npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.5.3"
  }
}
